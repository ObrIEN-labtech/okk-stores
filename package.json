{
  "name": "okk-stores",
  "version": "2.5.1",
  "description": "OKK Stores Inventory & Invoicing",
  "main": "main.js",
  "author": "OKK Stores",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build:win": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "backup": "node scripts/backup-db.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "chart.js": "^4.4.6",
    "electron-updater": "^6.3.9",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.okkstores.app",
    "productName": "OKK Stores",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "repository.js",
      "ui.js",
      "updater.js",
      "index.html",
      "style.css",
      "lib/**/*",
      "node_modules/**/*"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ObrIEN-labtech",
        "repo": "okk-stores",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OKK Stores"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
